{
  "name": "fanbar-compatibility-service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --local",
    "types": "wrangler types --include-runtime=false --strict-vars=false",
    "check": "wrangler types --include-runtime=false --strict-vars=false --check && tsc --noEmit && node scripts/schema.ts --check",
    "schema": "node scripts/schema.ts",
    "test": "vitest run && node --test test/localization.test.mjs",
    "db:local": "wrangler d1 migrations apply fanbar-compatibility --local",
    "dry-run": "wrangler deploy --dry-run --env production",
    "deploy": "wrangler deploy --env production"
  },
  "dependencies": {
    "jose": "6.2.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.1",
    "@cloudflare/workers-types": "5.20261013.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.150.0"
  }
}

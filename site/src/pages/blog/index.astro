---
import { getCollection } from "astro:content";
import { ArrowRight } from "lucide-astro";
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { blogUrl, formatPostDate, postUrl } from "@/lib/blog";
import { getDictionary } from "@/lib/i18n";
import { siteUrl } from "@/lib/seo";

const locale = "en" as const;
const dict = getDictionary(locale);
const posts = (await getCollection("blog")).sort((a, b) => b.data.publishedOn.localeCompare(a.data.publishedOn));
---

<BaseLayout
  locale={locale}
  dict={dict}
  seo={{
    title: "FanBar Blog: Mac Fans, Temperatures, and Cooling",
    description: "Practical guides to Mac fan noise, temperatures, and cooling on Apple Silicon and Intel, from the team behind FanBar.",
    canonical: blogUrl,
    alternates: [{ lang: "en", href: blogUrl }, { lang: "x-default", href: blogUrl }],
    preloadHero: false,
    structuredData: {
      "@context": "https://schema.org",
      "@type": "Blog",
      "@id": `${blogUrl}#blog`,
      url: blogUrl,
      name: "FanBar Blog",
      inLanguage: "en",
      publisher: { "@id": `${siteUrl}/#publisher` },
      blogPost: posts.map((post) => ({ "@type": "BlogPosting", headline: post.data.title, url: postUrl(post.id), datePublished: post.data.publishedOn })),
    },
  }}
>
  <Nav locale={locale} dict={dict} />

  <main class="mx-auto max-w-[44rem] px-6 pt-14 pb-24 sm:px-8 md:pt-20">
    <SectionLabel>Blog</SectionLabel>
    <h1 class="mt-6 font-display text-[2.4rem] leading-[1.1] tracking-[-0.02em] sm:text-5xl">Mac fans and temperatures, explained.</h1>
    <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
      Practical guides from the team that builds FanBar — written to fix the problem, not to sell the app.
    </p>

    <ul class="mt-14 divide-y divide-border border-y border-border">
      {posts.map((post) => (
        <li>
          <a href={`/blog/${post.id}`} class="group block py-7">
            <p class="font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">
              <time datetime={post.data.publishedOn}>{formatPostDate(post.data.publishedOn)}</time>
            </p>
            <h2 class="mt-2 text-xl font-semibold tracking-[-0.01em] group-hover:text-accent">{post.data.title}</h2>
            <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">{post.data.description}</p>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
              Read<ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>

  <Footer locale={locale} dict={dict} />
</BaseLayout>

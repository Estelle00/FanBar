---
import SectionLabel from "./SectionLabel.astro";
import { github } from "@/lib/links";
import DownloadPicker from "./DownloadPicker.astro";
import type { Dictionary, Locale } from "@/lib/i18n";
import { formatReleaseDate, getReleases, releasePath } from "@/lib/releases";

interface Props {
  locale: Locale;
  dict: Dictionary;
}

const { locale, dict } = Astro.props;
const notesLocale = locale === "zh" ? "zh" : "en";
const [latest] = await getReleases(notesLocale);
---

<section id="download" class="relative bg-foreground text-white">
  <div class="dots-bg absolute inset-0 opacity-40" aria-hidden="true"></div>
  <div class="reveal relative mx-auto max-w-xl px-6 py-24 text-center sm:px-8">
    <SectionLabel tone="dark" center>{dict.finalCta.badge}</SectionLabel>
    <h2 class="mt-5 font-display text-[2.25rem] leading-[1.2] tracking-[-0.01em] text-white">
      {dict.finalCta.heading}
    </h2>
    <p class="mx-auto mt-4 max-w-sm text-[15px] leading-relaxed text-white/60">{dict.finalCta.body}</p>

    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <DownloadPicker
        locale={locale}
        location="final-cta"
        class="inline-flex h-12 items-center rounded-[10px] bg-accent px-6 text-[15px] font-medium text-white transition-[color,background-color,border-color,scale] duration-150 ease-out hover:bg-[#0043d6] active:scale-[0.98]"
      >
        {dict.finalCta.primaryCta}
      </DownloadPicker>
      <a
        href={github}
        target="_blank"
        rel="noopener noreferrer"
        data-track-event="view-source"
        data-track-location="final-cta"
        data-track-locale={locale}
        class="inline-flex h-12 items-center rounded-[10px] border border-white/30 px-6 text-[15px] font-medium text-white transition-[color,background-color,border-color,scale] duration-150 ease-out hover:border-white active:scale-[0.98]"
      >
        {dict.finalCta.secondaryCta}
      </a>
    </div>

    <p class="mt-5 font-mono text-xs tracking-[0.04em] text-white/40">{dict.finalCta.caption}</p>

    {latest && (
      <p class="mt-4 text-sm text-white/65">
        {dict.finalCta.latest.replace("{version}", latest.data.version).replace("{date}", formatReleaseDate(latest.data.publishedAt, locale))}
        {" · "}
        <a href={releasePath(notesLocale, latest.data.version)} data-track-event="view-release-notes" data-track-location="final-cta" data-track-locale={locale} class="font-medium text-white underline decoration-white/30 underline-offset-4 hover:decoration-white">{dict.finalCta.latestLink}</a>
      </p>
    )}

    {dict.finalCta.verify && (
      <div class="mt-10 rounded-xl border border-white/15 bg-white/[0.04] p-5 text-left">
        <h3 class="text-[15px] font-semibold text-white">{dict.finalCta.verify.heading}</h3>
        <p class="mt-2 text-sm leading-relaxed text-white/65">{dict.finalCta.verify.body}</p>
        <pre class="mt-3 whitespace-pre-wrap rounded-lg bg-black/30 px-4 py-3 font-mono text-[13px] text-white"><code>{dict.finalCta.verify.command}</code></pre>
        <p class="mt-3 text-sm leading-relaxed text-white/65">{dict.finalCta.verify.expected}</p>
      </div>
    )}
  </div>
</section>

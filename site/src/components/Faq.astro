---
import { ChevronDown } from "lucide-astro";
import SectionLabel from "./SectionLabel.astro";
import type { Dictionary } from "@/lib/i18n";

interface Props {
  dict: Dictionary;
}

const { dict } = Astro.props;
---

<section id="faq" class="mx-auto max-w-5xl px-6 pb-28 sm:px-8">
  <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-14">
    <div class="reveal">
      <SectionLabel>{dict.faq.badge}</SectionLabel>
      <h2 class="mt-4 max-w-lg font-display text-3xl leading-[1.2] tracking-[-0.01em] md:text-4xl">
        {dict.faq.heading}
      </h2>
      <p class="mt-4 max-w-xl text-[15px] leading-relaxed text-muted-foreground">{dict.faq.body}</p>
    </div>

    <!-- Answers stay in the HTML when collapsed, so search and the FAQPage schema still see them. -->
    <div class="reveal border-b border-border">
      {dict.faq.items.map((item, index) => (
        <details class="group border-t border-border" open={index === 0}>
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-4 text-base font-semibold tracking-[-0.01em] transition-colors hover:text-accent [&::-webkit-details-marker]:hidden">
            <h3>{item.question}</h3>
            <ChevronDown
              class="h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200 ease-out group-open:rotate-180 motion-reduce:transition-none"
              aria-hidden="true"
            />
          </summary>
          <p class="pb-5 pr-10 text-sm leading-relaxed text-muted-foreground">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

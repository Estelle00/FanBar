---
import { ArrowRight, Rss } from "lucide-astro";
import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import SectionLabel from "@/components/SectionLabel.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDictionary, type FullLocale } from "@/lib/i18n";
import {
  formatReleaseDate,
  getReleases,
  releaseCopy,
  releasePath,
  releasesFeedPath,
  releasesPath,
} from "@/lib/releases";
import { siteUrl } from "@/lib/seo";

interface Props {
  locale: FullLocale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const copy = releaseCopy[locale];
const releases = await getReleases(locale);
const url = `${siteUrl}${releasesPath(locale)}`;
---

<BaseLayout
  locale={locale}
  dict={dict}
  seo={{
    title: copy.indexTitle,
    description: copy.indexDescription,
    canonical: url,
    alternates: [
      { lang: "en", href: `${siteUrl}${releasesPath("en")}` },
      { lang: "zh-Hans", href: `${siteUrl}${releasesPath("zh")}` },
      { lang: "x-default", href: `${siteUrl}${releasesPath("en")}` },
    ],
    preloadHero: false,
    modifiedTime: releases[0]?.data.publishedAt,
    structuredData: {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "@id": `${url}#page`,
      url,
      name: copy.indexHeading,
      inLanguage: locale === "zh" ? "zh-Hans" : "en",
      isPartOf: { "@id": `${siteUrl}/#website` },
      dateModified: releases[0]?.data.publishedAt,
    },
  }}
>
  <Nav locale={locale} dict={dict} />

  <main class="mx-auto max-w-[44rem] px-6 pt-14 pb-24 sm:px-8 md:pt-20">
    <SectionLabel>{copy.label}</SectionLabel>
    <h1 class="mt-6 font-display text-[2.6rem] leading-[1.1] tracking-[-0.02em] sm:text-5xl">{copy.indexHeading}</h1>
    <p class="mt-5 text-lg leading-relaxed text-muted-foreground">{copy.indexLede}</p>
    <a href={releasesFeedPath} class="mt-4 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-muted-foreground hover:text-foreground">
      <Rss class="h-4 w-4" aria-hidden="true" />{copy.feed}
    </a>

    <ol class="mt-10 border-l border-border">
      {releases.map((entry, index) => (
        <li class="relative pb-10 pl-7 last:pb-0">
          <span
            class:list={[
              "absolute top-2 -left-[5px] h-[9px] w-[9px] rounded-full border-2 border-background",
              index === 0 ? "bg-accent" : "bg-border",
            ]}
            aria-hidden="true"
          />
          <p class="font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">
            <time datetime={entry.data.publishedAt}>{formatReleaseDate(entry.data.publishedAt, locale)}</time>
            {index === 0 && <span class="ml-2 text-accent">· {copy.latest}</span>}
          </p>
          <h2 class="mt-1.5 text-xl font-semibold tracking-[-0.01em]">
            <a href={releasePath(locale, entry.data.version)} data-track-event="view-release-notes" data-track-location="release-index" data-track-locale={locale} data-track-version={entry.data.version} class="hover:text-accent">FanBar {entry.data.version}</a>
          </h2>
          {entry.data.highlights.length > 0 && (
            <ul class="mt-3 space-y-1.5 text-[15px] leading-relaxed text-muted-foreground">
              {entry.data.highlights.map((title) => <li>{title}</li>)}
            </ul>
          )}
          <a href={releasePath(locale, entry.data.version)} data-track-event="view-release-notes" data-track-location="release-index" data-track-locale={locale} data-track-version={entry.data.version} class="mt-3 inline-flex min-h-11 items-center gap-1.5 text-sm font-medium text-accent">
            {copy.label}<ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ol>
  </main>

  <Footer locale={locale} dict={dict} />
</BaseLayout>
